<% whitelist = local_assigns[:whitelist] %>

<% filter_form.object.class.attributes.each do |attribute_name, attribute_type| %>
  <% field_definition = FieldDefinitions::BeneficiaryFields.find_by!(name: attribute_name) %>

  <%= render(
    "shared/filter_form/field",
    filter_form:,
    field_name: attribute_name,
    field_definition:,
    visibility: ("hidden".inquiry if whitelist.present? && whitelist.exclude?(field_definition))
  ) %>
<% end %>
