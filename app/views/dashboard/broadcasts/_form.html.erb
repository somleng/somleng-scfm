<div class="card">
  <%= simple_form_for(
    [:dashboard, @broadcast],
    html: {
      data: {
        controller: :broadcasts,
        broadcasts_message_segment_warning_threshold_value: 1,
        broadcasts_character_count_translations_value: pluralized_translations(".character_count").to_json,
        broadcasts_deliverable_channels_value: BroadcastChannelCapabilities::DELIVERABLE_CHANNELS.to_json,
        broadcasts_text_channels_value: BroadcastChannelCapabilities::TEXT_CHANNELS.to_json,
        broadcasts_audio_channels_value: BroadcastChannelCapabilities::AUDIO_CHANNELS.to_json
      }
    }
  ) do |f| %>
    <div class="card-body">
      <div class="row">
        <div class="col">
          <%= f.input :name %>
        </div>
        <div class="col">
          <%= f.input(
            :channel,
            collection: f.object.channel_options_for_select,
            include_blank: false,
            disabled: f.object.persisted?,
            input_html: {
              data: {
                broadcasts_target: "channelInput",
                action: "broadcasts#toggleChannel"
              }
            }
          ) %>
        </div>
        <div class="col" data-broadcasts-target="audioFileInput">
          <%= f.input(
            :audio_file,
            hint: (link_to(@broadcast.object.audio_file.filename, rails_blob_path(@broadcast.object.audio_file)) if @broadcast.persisted? && @broadcast.object.audio_file.attached?),
            required: f.object.new_record?,
            as: :file,
            input_html: {
              direct_upload: true,
              accept: Broadcast::AUDIO_CONTENT_TYPES.join(", ")
            }
          ) %>
        </div>
        <div class="col" data-broadcasts-target="messageInput">
          <%= f.input(
            :message,
            as: :text,
            required: f.object.new_record?,
            info: t(".character_count", count: 0),
            warning: t(".message_segment_warning"),
            input_html: { rows: 4, data: { action: "broadcasts#updateMessageInfo" } }
          ) %>
        </div>
      </div>
      <div class="row">
        <div class="col-4", data-broadcasts-target="beneficiaryGroupsInput">
          <%= f.input(
            :beneficiary_groups,
            collection: f.object.account.beneficiary_groups,
            multiple: true,
            input_html: {
              class: "list-select"
            }
          ) %>
        </div>
      </div>

      <%= tag.div(data: { broadcasts_target: "beneficiaryFiltersContainer" }) do %>
        <% beneficiary_fields = @broadcast.beneficiary_filter_fields %>
        <% if beneficiary_fields.any? %>
          <div class="hr-text">
            <%= t("beneficiary_filters")%>
          </div>

          <%= render("shared/filter_form/field_headers") %>
        <% end %>

        <%= f.simple_fields_for(:beneficiary_filter, @broadcast.beneficiary_filter) do |filter_form| %>
          <%= render(
            "dashboard/beneficiaries/filter_fields",
            filter_form:,
            whitelist: beneficiary_fields
          ) %>
        <% end %>
      <% end %>

      <div class="hr-text">
        <%= Broadcast.human_attribute_name(:target_areas) %>
      </div>

      <% if CountryLocalityData.supported?(current_account.iso_country_code)  %>
        <%= f.input(
          :geocode_target_areas,
          as: :hidden,
          input_html: {
            value: @broadcast.geocode_target_areas.as_json.to_json,
          }
        ) %>

        <div class="row" id="target_areas">
          <div class="col">
            <%= tag.div(
              data: {
                controller: :treeview,
                treeview_data_value: locality_tree.to_json,
                treeview_selected_value: @broadcast.object.geocode_target_areas.pluck(:path).to_json
              }
            ) %>
          </div>
        </div>
      <% else %>
        <% geocode_target_areas = @broadcast.geocode_target_areas %>
        <%= f.input(
          :geocode_target_areas,
          as: :text,
          label: safe_join(
            [
              f.label(:geocode_target_areas),
              link_to(
                "https://www.open-ews.org/docs/api/#broadcasts",
                target: "_blank",
                rel: "noopener",
                style: "text-decoration: none;",
                aria: { label: "Help" }
              ) do
                content_tag(:i, "", class: "ti ti-info-circle")
              end
            ], " "
          ),
          hint: true,
          input_html: {
            rows: 10,
            value: (geocode_target_areas.present? && geocode_target_areas.is_a?(Array)) ? JSON.pretty_generate(geocode_target_areas) : geocode_target_areas,
          },
          placeholder: <<~JSON.strip
            [
              {
                "iso_region_code": "KH-1"
              },
              {
                "iso_region_code": "KH-2",
                "administrative_division_level_2_code": "0201"
              }
            ]
          JSON
        ) %>
      <% end %>
    </div>

    <div class="card-footer text-end">
      <%= f.button(:submit, class: 'btn btn-primary') %>
    </div>
  <% end %>
</div>
