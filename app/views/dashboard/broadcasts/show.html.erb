<% content_for(:page_actions) do %>
  <% if @broadcast.state_machine.may_transition_to?(:running) %>
    <%= button_to(
      dashboard_broadcast_state_path(@broadcast, desired_status: "running"),
      method: :post,
      class: "btn btn-outline-success",
      form_class: "d-inline",
      form: {
        data: {
          turbo_confirm: start_broadcast_confirmation(@broadcast)
        }
      }
    ) do %>
      <i class="icon ti ti-player-play"></i>
      <%= title(controller_name: :broadcasts, action_name: :start, default: "Start") %>
    <% end %>

  <% elsif @broadcast.state_machine.may_transition_to?(:stopped) %>
    <%= button_to(
      dashboard_broadcast_state_path(@broadcast, desired_status: "stopped"),
      method: :post,
      class: "btn btn-outline-danger",
      form_class: "d-inline",
      form: { data: { turbo_confirm: action(:confirm, default: "Are you sure?") } }
    ) do %>
      <i class="icon ti ti-player-stop-filled"></i>
      <%= title(controller_name: :broadcasts, action_name: :stop, default: "Stop") %>
    <% end %>
  <% end %>

  <% if @broadcast.state_machine.updatable? %>
    <%= render "shared/edit_resource_page_action", path: edit_dashboard_broadcast_path(@broadcast) %>

    <%= render "shared/resource_related_links" do %>
      <%= render "shared/destroy_resource_page_action", path: dashboard_broadcast_path(@broadcast) %>
    <% end %>
  <% elsif @broadcast.channel_capabilities.any?(&:deliverable?) %>
    <%= render "shared/resource_related_links" do %>
      <%= link_to(dashboard_broadcast_notifications_path(@broadcast), class: "dropdown-item") do %>
        <i class="icon ti ti-message"></i>
        <%= title(controller_name: :notifications, action_name: :index) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="card">
  <div class="card-body">
    <%= show_for(@broadcast) do |f| %>
      <%= f.attribute :id %>
      <%= f.attribute :name %>
      <%= f.attribute :channel, value: @broadcast.channel_text %>

      <%= f.attribute :beneficiary_groups do %>
        <% @broadcast.beneficiary_groups.each do |beneficiary_group| %>
          <span class="badge bg-default-lt">
            <%= link_to(beneficiary_group.name, dashboard_beneficiary_group_path(beneficiary_group)) %>
          </span>
        <% end %>
      <% end %>

      <%= f.attribute :status do %>
        <%= broadcast_status(@broadcast) %>
        <% if @broadcast.errored? %>
          <div class="text-danger"><%= error_message_for(@broadcast.error_code) %></div>
        <% end %>

        <% if @broadcast.channel_capabilities.any?(&:deliverable?) %>
          <div class="notification-stats mt-3">
            <div class="progress progress-separated mb-3">
              <% @broadcast.notification_stats_percentage.each do |status, percentage| %>
                <% count = @broadcast.notification_stats[status] %>
                <%= tag.div(
                  class: [
                    "progress-bar",
                    "bg-#{notification_status_color(status)}"
                  ],
                  role: "progressbar",
                  data: {
                    bs_toggle: "popover",
                    bs_content: count_of_total(
                      count,
                      total: pluralize_model(
                        @broadcast.total_notifications_count, Notification.model_name
                      )
                    ),
                    bs_trigger: "hover"
                  },
                  style: "width: #{percentage}%"
                ) %>
              <% end %>
            </div>

            <div class="row">
              <% @broadcast.notification_stats_percentage.each do |status, percentage| %>
                <% count = @broadcast.notification_stats[status] %>
                <%= tag.div(
                  class: "col-auto d-flex align-items-center pe-2",
                  data: {
                    bs_toggle: "popover",
                    bs_content: count_of_total(
                      count,
                      total: pluralize_model(
                        @broadcast.total_notifications_count,
                        Notification.model_name
                      )
                    ),
                    bs_trigger: "hover",
                    bs_placement: "top",
                  }
                ) do %>
                  <%= tag.span(
                    class: [
                      "legend",
                      "me-2",
                      "bg-#{notification_status_color(status)}"
                    ]
                  ) %>

                  <span>
                    <%= t("statuses.#{status}", default: status.to_s.humanize) %>
                  </span>

                  <span class="d-none d-md-inline d-lg-none d-xxl-inline ms-2 text-secondary">
                    <%= number_to_percentage(percentage, precision: 0, strip_insignificant_zeros: true) %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @broadcast.channel_capabilities.any?(&:audio?) %>
        <%= f.attribute :audio_file do %>
          <% if @broadcast.audio_file.attached? %>
            <%= audio_tag(@broadcast.audio_file, controls: true) %>
          <% end %>
        <% end %>
      <% end %>

      <% if @broadcast.channel_capabilities.any?(&:text?) %>
        <%= f.attribute :message do %>
          <%= text_area_tag(:message, @broadcast.message, rows: 4, class: "form-control w-100", readonly: true) %>
        <% end %>
      <% end %>

      <%= f.attribute :created_by do %>
        <%= user_link(f.object.created_by) %>
      <% end %>

      <%= f.attribute :updated_by do %>
        <%= user_link(f.object.updated_by) %>
      <% end %>

      <%= f.attribute :started_by do %>
        <%= user_link(f.object.started_by) %>
      <% end %>

      <%= f.attribute :stopped_by do %>
        <%= user_link(f.object.stopped_by) %>
      <% end %>

      <%= f.attribute :started_at, value: local_time(@broadcast.started_at) %>
      <%= f.attribute :created_at, value: local_time(@broadcast.created_at) %>
      <%= f.attribute :updated_at, value: local_time(@broadcast.updated_at) %>
    <% end %>

    <% if @broadcast.beneficiary_filter.present? %>
      <div class="hr-text">
        <%= t("beneficiary_filters")%>
      </div>

      <%= render("shared/filter_form/field_headers") %>

      <% filter = BeneficiaryFilterData.new(data: @broadcast.beneficiary_filter) %>
      <% filter.data.fields.values.each do |field| %>
        <div class="row mb-3" id="beneficiary_filter_<%= field.name %>">
          <div class="col">
            <%= tag.input(
              class: "field-name form-control",
              type: "text",
              value: human_attribute_name(field.name, namespace: current_account.iso_country_code),
              readonly: true
            ) %>
          </div>
          <div class="col">
            <%= tag.input(
              class: "field-operator form-control",
              type: "text",
              value: human_operator(field.operator),
              readonly: true
            ) %>
          </div>
          <div class="col">
            <% if field.operator == "between" %>
              <div class="row">
                <% field.value.each do |value| %>
                  <div class="col">
                    <%= tag.input(
                      class: "field-value form-control",
                      type: "text",
                      value:,
                      readonly: true
                    ) %>
                  </div>
                <% end %>
              </div>
            <% elsif field.value.is_a?(Array) %>
              <select class="input-tags-readonly form-control" readonly multiple>
                <% field.value.each do |value| %>
                  <option selected><%= human_value(value, schema: field.field_definition.filter.schema) %></option>
                <% end %>
              </select>
            <% else %>
              <%= tag.input(
                class: "field-value form-control",
                type: "text",
                value: human_value(field.value, schema: field.field_definition.filter.schema),
                readonly: true
              ) %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @broadcast.target_areas.present? %>
      <div class="hr-text">
        <%= Broadcast.human_attribute_name(:target_areas) %>
      </div>

      <% if CountryLocalityData.supported?(current_account.iso_country_code) %>
        <div class="row" id="target_areas">
          <div class="col">
            <%= tag.div(
              data: {
                controller: :treeview,
                treeview_data_value: locality_tree.to_json,
                treeview_selected_value: @broadcast.geocode_target_areas.pluck(:path).to_json
              }
            ) %>
          </div>
        </div>
      <% else %>
        <%= show_for(@broadcast) do |f| %>
          <%= f.attribute :target_areas, label: false do %>
            <%= text_area_tag(
              :target_areas,
              JSON.pretty_generate(@broadcast.target_areas.as_json),
              rows: 10,
              class: "form-control w-100",
              readonly: true
            ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
